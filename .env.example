APP_ENV=development
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Same-origin /api di Next.js. Tidak perlu API Go.
# API_ADDR hanya dipakai binary backend/cmd/api jika dijalankan manual.

# --- Pengembangan lokal (aktifkan blok ini) ---
# Docker Compose: docker compose up -d
# Atau Postgres Windows: user/password/db sesuai instalasi Anda, sslmode=disable.
DATABASE_URL=postgresql://myticketin:myticketin_dev@127.0.0.1:5432/myticketin?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://myticketin:myticketin_dev@127.0.0.1:5432/myticketin?sslmode=disable

# --- Deployment Neon (aktifkan blok ini, matikan URL lokal) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Google OAuth (opsional, berpasangan). Kosongkan untuk menyembunyikan tombol Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus sama persis dengan Authorized redirect URIs di Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# F76 poster suggestions: biarkan false sampai gate provider/model/privacy/cost disetujui.
# Jika true tanpa AI_PROVIDER, AI_MODEL, timeout, dan budget, API gagal start.
AI_POSTER_SUGGESTIONS_ENABLED=false
# AI_PROVIDER=
# AI_MODEL=
# AI_MAX_IMAGE_BYTES=5242880
# AI_REQUEST_TIMEOUT_MS=15000
# F77 catalog natural-language filter: biarkan false sampai gate provider/model/privacy/cost disetujui.
# Jika true, API gagal start (belum ada provider yang disetujui).
AI_CATALOG_FILTER_ENABLED=false

# Secret pemicu job expiry order (HTTP POST /api/internal/jobs/expire-orders).
# Wajib ≥32 karakter pada preview/production-demo. Development memakai SESSION_SECRET jika kosong.
SCHEDULER_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Secret HMAC webhook sandbox in-process (header X-Sandbox-Signature).
# Development memakai SESSION_SECRET jika kosong. Wajib ≥32 karakter pada preview/production-demo.
# Jangan mengisi credential payment produksi (contoh MIDTRANS_SERVER_KEY / XENDIT_SECRET_KEY).
PAYMENT_WEBHOOK_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# QR token pepper + AES-256-GCM keys (RFC-010). Development/test menurunkan dari SESSION_SECRET jika kosong.
# Preview/production-demo wajib eksplisit, ≥32 karakter, berbeda dari SESSION_SECRET.
# QR_ENCRYPTION_KEYS format: 1:<64-hex-32-byte-key>
# QR_TOKEN_PEPPER=
# QR_ENCRYPTION_KEYS=
# QR_ACTIVE_KEY_VERSION=1

# HMAC fingerprint attempt log (RFC-011). Development menurunkan dari SESSION_SECRET jika kosong.
# Wajib eksplisit dan berbeda dari QR_TOKEN_PEPPER pada preview/production-demo.
# CHECKIN_FINGERPRINT_KEY=

# F47 grafik tren penjualan dan F48 pencarian admin (RFC-012 Could Have). Default false.
# ENABLE_SALES_TREND=false
# ENABLE_ADMIN_SEARCH=false

# RFC-013 email: hanya adapter sandbox sampai decision gate provider ditutup. Development default sandbox.
# EMAIL_PROVIDER=sandbox
# RFC-014: waktu snapshot backup (RFC3339). Kosong = health backupFreshness unknown (blokir restore-drill).
# BACKUP_SNAPSHOT_AT=2026-09-22T00:00:00Z
