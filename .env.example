APP_ENV=development
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Same-origin /api di Next.js. Tidak perlu API Go.
# API_ADDR hanya dipakai binary backend/cmd/api jika dijalankan manual.

# --- Pengembangan lokal (aktifkan blok ini) ---
# Docker Compose: docker compose up -d
# Atau Postgres Windows: user/password/db sesuai instalasi Anda, sslmode=disable.
DATABASE_URL=postgresql://myticketin:myticketin_dev@127.0.0.1:5432/myticketin?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://myticketin:myticketin_dev@127.0.0.1:5432/myticketin?sslmode=disable

# --- Deployment Neon (aktifkan blok ini, matikan URL lokal) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Google OAuth (opsional, berpasangan). Kosongkan untuk menyembunyikan tombol Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus sama persis dengan Authorized redirect URIs di Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Galeri event di Vercel: Cloudflare R2 (S3-compatible). Lokal tanpa ini tetap menulis ke uploads/gallery/.
# GALLERY_S3_BUCKET=myticketin-gallery
# AWS_ENDPOINT_URL_S3=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# GALLERY_S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Jika true tanpa AI_PROVIDER, AI_MODEL, timeout, dan budget, API gagal start.
AI_POSTER_SUGGESTIONS_ENABLED=false
# AI_PROVIDER=
# AI_MODEL=
# AI_MAX_IMAGE_BYTES=5242880
# AI_REQUEST_TIMEOUT_MS=15000
# F77 catalog natural-language filter: biarkan false sampai gate provider/model/privacy/cost disetujui.
# Satu-satunya provider yang tersedia saat ini: AI_PROVIDER=fake (parser berbasis aturan yang deterministik,
# bukan model bahasa; cocok untuk demo/uji tanpa biaya). Nilai lain, atau tanpa AI_PROVIDER, membuat API memakai
# pencarian kata kunci (fallback) sehingga katalog tetap berfungsi.
AI_CATALOG_FILTER_ENABLED=false
# AI_PROVIDER=fake
#
# Model bahasa sungguhan lewat endpoint yang kompatibel dengan OpenAI chat/completions (tanpa SDK tambahan).
# Teks pencarian pembeli, daftar kategori/kota Published, dan tanggal hari ini dikirim ke vendor; periksa kebijakan
# retensi vendor dan pakai kunci khusus aplikasi ini. Base URL wajib HTTPS. Timeout dibatasi maksimum 5000 ms.
# Contoh (Gemini, ada free tier): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-flash-lite-latest
#   (nama model Gemini lama cepat dihentikan; alias "-latest" tidak basi. Daftar model: GET {AI_BASE_URL}/models)
# Contoh (OpenAI):                 AI_BASE_URL=https://api.openai.com/v1                               AI_MODEL=gpt-4o-mini
# Contoh (Ollama lokal, gratis, teks tidak keluar dari komputer): jalankan `ollama pull llama3.2` lalu
#   AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.2  AI_API_KEY dikosongkan  AI_REQUEST_TIMEOUT_MS=15000
#   (batas 15 detik hanya berlaku untuk localhost; server jarak jauh tetap maksimum 5 detik)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_REQUEST_TIMEOUT_MS=5000

# Secret pemicu job expiry order (HTTP POST /api/internal/jobs/expire-orders).
# Wajib ≥32 karakter pada preview/production-demo. Development memakai SESSION_SECRET jika kosong.
SCHEDULER_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Secret HMAC webhook sandbox in-process (header X-Sandbox-Signature).
# Development memakai SESSION_SECRET jika kosong. Wajib ≥32 karakter pada preview/production-demo.
# Jangan mengisi credential payment produksi (kunci Midtrans selain SB-Mid-server-... ditolak aplikasi).
PAYMENT_WEBHOOK_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Provider pembayaran: sandbox (simulator internal, default; dipakai tes/CI) atau midtrans (Midtrans Sandbox, Snap redirect).
PAYMENT_PROVIDER=sandbox
# Hanya Server Key SANDBOX Midtrans (berawalan SB-Mid-server-). Diperlukan jika PAYMENT_PROVIDER=midtrans.
# Payment Notification URL di dashboard Midtrans Sandbox: https://<domain-anda>/api/webhooks/payments/midtrans
MIDTRANS_SERVER_KEY=

# Pencairan dana ke penyelenggara (sandbox): jam tahan setelah event selesai sebelum dapat diajukan (default 24, 0 = langsung).
PAYOUT_HOLD_HOURS=24

# QR token pepper + AES-256-GCM keys (RFC-010). Development/test menurunkan dari SESSION_SECRET jika kosong.
# Preview/production-demo wajib eksplisit, ≥32 karakter, berbeda dari SESSION_SECRET.
# QR_ENCRYPTION_KEYS format: 1:<64-hex-32-byte-key>
# QR_TOKEN_PEPPER=
# QR_ENCRYPTION_KEYS=
# QR_ACTIVE_KEY_VERSION=1

# HMAC fingerprint attempt log (RFC-011). Development menurunkan dari SESSION_SECRET jika kosong.
# Wajib eksplisit dan berbeda dari QR_TOKEN_PEPPER pada preview/production-demo.
# CHECKIN_FINGERPRINT_KEY=

# F47 grafik tren penjualan dan F48 pencarian admin (RFC-012 Could Have). Default false.
# ENABLE_SALES_TREND=false
# ENABLE_ADMIN_SEARCH=false

# RFC-013 email: adapter sandbox sampai decision gate provider ditutup. Development default sandbox.
# EMAIL_PROVIDER=sandbox
# EMAIL_FROM=MyTicketIn <noreply@localhost>
# Kirim tautan reset: Gmail wajib App Password 16 karakter (bukan kata sandi akun).
# https://myaccount.google.com/apppasswords
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=akun@gmail.com
# EMAIL_SMTP_PASSWORD=abcdefghijklmnop
# RESEND_API_KEY=
# RFC-014: waktu snapshot backup (RFC3339). Kosong = health backupFreshness unknown (blokir restore-drill).
# BACKUP_SNAPSHOT_AT=2026-09-22T00:00:00Z

# Kunci AES-256 untuk dokumen identitas organizer (64 hex atau base64 32 byte). Wajib; tidak ada fallback.
DOCUMENT_ENCRYPTION_KEY=ganti-dengan-64-karakter-hex-acak

# Ollama Cloud (AI_PROVIDER=ollama-cloud). Isi di .env.local, jangan di sini. Model default gemma4:31b (OLLAMA_MODEL untuk mengganti).
OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma4:31b
