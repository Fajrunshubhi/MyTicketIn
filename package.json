{
  "name": "event-ticketing-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db-check": "tsx --env-file=.env.local scripts/check-db.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "smoke": "tsx scripts/smoke.ts",
    "restore-drill": "tsx scripts/restore-drill.ts",
    "api:test": "go test -C backend ./...",
    "api:dev": "go run -C backend ./cmd/api"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^0.10.4",
    "@zxing/browser": "0.2.1",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "3.2.4"
  }
}
